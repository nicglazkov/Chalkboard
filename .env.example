# Copy this file to .env and fill in your keys
# .env is gitignored, never commit it

# Required
ANTHROPIC_API_KEY=

# TTS backend: kokoro (code default when unset; not on Intel Macs), openai, elevenlabs
TTS_BACKEND=openai

# Only needed for the selected TTS backend
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ── Claude models ────────────────────────────────────────────────────────────
# One model for every agent (default claude-opus-5-5):
# CLAUDE_MODEL=claude-opus-5-5
# Per-agent model override, CLAUDE_MODEL_<AGENT>. Agents: RESEARCH, SCRIPT, FACT,
# MANIM, CODE_VALIDATOR, VISUAL_QA, QUIZ. Example (cheaper validators):
# CLAUDE_MODEL_FACT=claude-sonnet-5-5
# CLAUDE_MODEL_CODE_VALIDATOR=claude-sonnet-5-5
# Per-agent effort, CLAUDE_EFFORT_<AGENT> (low | medium | high). Defaults:
# research=medium script=high fact=medium manim=high code_validator=medium
# visual_qa=high quiz=low. Ignored for Haiku models.
# CLAUDE_EFFORT_MANIM=high

# ── Rendering ────────────────────────────────────────────────────────────────
# auto (default): local if manim + latex + dvisvgm + ffmpeg are available, else docker
# local: needs `pip install -r requirements-render.txt` + TeX (see README > Rendering)
# docker: builds and uses the chalkboard-render image
# RENDER_BACKEND=auto
# Render resolution: low (480p15) | medium (720p30) | high (1080p60) | 4k (2160p60)
# MANIM_QUALITY=medium
# Scene fonts (defaults: CMU Serif if installed, else Inter; JetBrains Mono NL, else DejaVu Sans Mono).
# The code font must be ligature-free.
# CHALKBOARD_TEXT_FONT=CMU Serif
# CHALKBOARD_CODE_FONT=DejaVu Sans Mono

# ── TTS voices ───────────────────────────────────────────────────────────────
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# Delivery instructions, only sent to gpt-* TTS models (default: a clear teaching voice)
# OPENAI_TTS_INSTRUCTIONS="Speak clearly and warmly at a steady teaching pace."
# KOKORO_VOICE=af_heart
# Named voice: aria | milo (ElevenLabs) | kokoro | alloy (OpenAI).
# Overrides TTS_BACKEND when set. See README > Narration.
# NARRATOR=aria
# ELEVENLABS_MODEL_ID=eleven_v4
# ELEVENLABS_STITCH=1
# ELEVENLABS_CONCURRENCY=3
# ELEVENLABS_VOICE_ID=1iNDh1muacMMMHXvS7Ym

# ── Pipeline defaults ────────────────────────────────────────────────────────
# DEFAULT_EFFORT=medium          # low | medium | high
# DEFAULT_AUDIENCE=intermediate  # beginner | intermediate | expert
# DEFAULT_TONE=casual            # casual | formal | socratic
# DEFAULT_THEME=chalkboard       # chalkboard | light | colorful
# OUTPUT_DIR=./output
# CHECKPOINT_DB=pipeline_state.db

# ── Web server ───────────────────────────────────────────────────────────────
# Bind address. 127.0.0.1 = this machine only; 0.0.0.0 = your LAN (there is no auth)
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000
# Jobs that run at once; further jobs wait their turn
# MAX_CONCURRENT_JOBS=3
